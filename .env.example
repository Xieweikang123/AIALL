# AIALL 环境变量说明
#
# 此文件仅供文档参考，不要将真实密钥提交到仓库。
# 应用在 UI 界面中（/ai-config）配置 AI 模型与 API 密钥（桌面版）。

# ── agent-server（无头 HTTP 服务，`cargo run --bin agent-server`）──

# 监听地址/端口（默认 127.0.0.1:8787）。公网暴露前必须先完成安全加固（见 docs/TASK-C-security.md）。
# AIALL_SERVER_BIND=127.0.0.1
# AIALL_SERVER_PORT=8787

# 认证：账号固定 admin，密码见 AIALL_SERVER_ADMIN_PASSWORD（优先）或旧变量 AIALL_SERVER_TOKEN。
# 未设环境变量时，首次启动会自动在 ~/.config/aiall/server-auth.json 生成随机密码。
# 所有受保护路由要求 `Authorization: Bearer <password>`，或先 POST /api/server/login {username,password} 换会话。
# 未配置时本地开发默认放行。登录后可 POST /api/server/change-password {oldPassword,newPassword} 修改密码。
# AIALL_SERVER_ADMIN_PASSWORD=
# AIALL_SERVER_TOKEN=  # 兼容旧版，等同于 admin 密码

# 项目沙箱白名单（逗号分隔的绝对路径）。空 = 全放行。设置后所有带 path/projectPath
# 参数的 /backend/vibe/* 路由与 /api/agent/run 都会校验路径必须落在白名单内。
# AIALL_SERVER_ALLOWED_PROJECTS=

# 服务器模式命令白名单开关：=1 时 Agent 的 run_command 只允许 npm/npx/node/cargo/git/ls/pwd/echo/make
# 且禁止 shell 拼接与 node 内联执行。仅服务器模式生效，桌面版行为不变。
# AIALL_SERVER_RESTRICT_COMMANDS=1

# 服务端 AI 配置（key 不下发浏览器；浏览器请求体里的 apiKey 为空时由服务端注入）。
# 也可以用 ~/.config/aiall/server-config.json：
#   { "endpoint": "...", "model": "...", "apiKey": "...", "webProxyUrl": "..." }
# AIALL_SERVER_AI_ENDPOINT=
# AIALL_SERVER_AI_MODEL=
# AIALL_SERVER_AI_KEY=
# AIALL_SERVER_AI_PROXY=

# 可选：网页抓取代理（用于 /chat 页面 URL 总结）
# WEB_PROXY_URL=http://127.0.0.1:7890
