# AIALL agent-server 环境变量模板
#
# 复制为 server.env（或直接填进 systemd unit 的 Environment=），并替换所有 __CHANGE_ME__。
# 不要把真实 token / key 提交到仓库。

# ── 网络 ──
# 监听地址：nginx 反代用 127.0.0.1；直连公网才用 0.0.0.0
AIALL_SERVER_BIND=127.0.0.1
# 监听端口
AIALL_SERVER_PORT=8088

# ── 认证（必填，公网暴露前）──
# 密码 / 静态 Bearer token；也是 POST /api/server/login 的 password（>= 32 字节随机）
AIALL_SERVER_TOKEN=__CHANGE_ME__

# ── 项目沙箱（必填，公网暴露前）──
# 逗号分隔的项目根目录绝对路径；请求的 path/projectPath 必须落在其中，否则 403
AIALL_SERVER_ALLOWED_PROJECTS=/srv/aiall/projects

# ── 命令白名单（建议开启）──
# =1 时 Agent 的 run_command 只允许 npm/npx/node/cargo/git/ls/pwd/echo/make，且禁 shell 拼接与 node 内联
AIALL_SERVER_RESTRICT_COMMANDS=1

# ── 服务端 AI 配置（可选；key 不下发浏览器）──
# 也可用 ~/.config/aiall/server-config.json 代替：
#   { "endpoint": "https://.../v1", "model": "...", "apiKey": "...", "webProxyUrl": "..." }
# AIALL_SERVER_AI_ENDPOINT=
# AIALL_SERVER_AI_MODEL=
# AIALL_SERVER_AI_KEY=__CHANGE_ME__
# AIALL_SERVER_AI_PROXY=
