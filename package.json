{
  "name": "aiall-desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "tauri dev",
    "test": "vitest run",
    "test:rust-agent": "node scripts/rust-agent-parity.mjs",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "agent:regression": "tsx scripts/agent-regression-rust.ts && vitest run src/services/agentRegression.test.ts && tsx scripts/agent-regression.ts",
    "agent:test-guards": "npm run test:rust-agent && vitest run server/projectContextParity.test.ts src/services/agentOrchestrationGuard.test.ts server/visionMessage.test.ts server/agentExplorationBudget.test.ts src/services/agentRegression.test.ts src/services/agentAuditRegression.test.ts",
    "lint": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "build:tauri": "cross-env vue-tsc --noEmit && cross-env vite build",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dompurify": "^3.4.8",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.10"
  }
}
