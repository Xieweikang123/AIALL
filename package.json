{
  "name": "aiall-desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sidecar": "tsx sidecar/main.ts",
    "dev:web": "vite",
    "dev": "concurrently -k -n backend,web -c blue,green \"npm run sidecar\" \"npm run dev:web\"",
    "test": "vitest run",
    "build:sidecar": "esbuild sidecar/main.ts --bundle --platform=node --format=cjs --outfile=sidecar/dist/main.cjs --packages=external",
    "build:tauri": "npm run build:sidecar && cross-env VITE_BACKEND_URL=http://127.0.0.1:37891 vue-tsc --noEmit && cross-env VITE_BACKEND_URL=http://127.0.0.1:37891 vite build",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "chokidar": "^5.0.0",
    "connect": "^3.7.0",
    "dompurify": "^3.4.8",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "sharp": "^0.34.5",
    "undici": "^7.25.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/connect": "^3.4.38",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.10"
  }
}
