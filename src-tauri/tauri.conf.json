{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIALL",
  "version": "0.1.0",
  "identifier": "com.aiall.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "AIALL 配置中心",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:37891 ipc: http://ipc.localhost https:; img-src 'self' data: blob: http://127.0.0.1:37891; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": [
      "../data",
      "../sidecar/dist"
    ]
  }
}
